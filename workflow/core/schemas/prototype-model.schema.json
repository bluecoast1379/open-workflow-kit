{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-workflow-kit.local/schemas/prototype-model.schema.json",
  "title": "Prototype Model",
  "type": "object",
  "required": ["schema_version", "feature", "sources", "pages"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "feature": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }, "name": { "type": "string" } }, "additionalProperties": true },
    "sources": { "type": "object" },
    "pages": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/page" } },
    "tokens": { "type": "object" },
    "components": { "type": "array" }
  },
  "$defs": {
    "page": { "type": "object", "required": ["id", "name", "nodes"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } } } },
    "node": { "type": "object", "required": ["id", "name", "type"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "type": { "enum": ["frame", "text", "rectangle", "ellipse", "component", "instance", "button"] }, "children": { "type": "array", "items": { "$ref": "#/$defs/node" } } } }
  }
}
