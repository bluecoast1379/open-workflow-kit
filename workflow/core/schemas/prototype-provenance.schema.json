{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-workflow-kit.local/schemas/prototype-provenance.schema.json",
  "title": "Prototype Provenance",
  "type": "object",
  "required": ["schema_version", "model_hash", "generator", "source_documents", "requirement_ids"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "model_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generator": { "type": "object", "required": ["name", "version"] },
    "source_documents": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "requirement_ids": { "type": "array", "items": { "type": "string" } }
  }
}
